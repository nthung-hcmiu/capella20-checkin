// Capella 20 nam - Luoc do co so du lieu dung chung
//
// Mac dinh: postgresql (cho production Supabase / Vercel).
// Chay demo cuc bo bang SQLite: `npm run use:sqlite` roi `npm run setup`.
// Doi lai Postgres: `npm run use:postgres`.
// Khong dung Prisma enum de giu tuong thich SQLite va Postgres;
// cac trang thai la String, dinh nghia tap trung o src/lib/constants.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Khi chuyen Supabase, bo comment dong duoi:
  // directUrl = env("DIRECT_URL")
}

// 5 venue chinh + cac dai so du phong / tai cua / BOD
model Venue {
  id         String  @id @default(cuid())
  code       String  @unique // RIVERSIDE, GALLERY, PARKVIEW, CLARIS, CHLOE, CHILL, MARKETING, TAICUA, BOD
  ten        String
  rangeStart Int // dau dai so thu tu, vi du 1000
  rangeEnd   Int // cuoi dai so thu tu, vi du 1999
  quota      Int     @default(0) // so thiep duoc cap (target gui thu moi)
  mucTieuCongTy   Int   @default(0) // muc tieu cong ty check in
  mucTieuKhach    Int   @default(0)
  doanhThuCamKet  Float @default(0) // VND
  soHopDongDuKien Int   @default(0)
  giaTriTiecTB    Float @default(0) // VND
  mauSac     String  @default("#b08d42")
  thuTu      Int     @default(0)
  guests     Guest[]
}

// Mot khach = mot ma. Khoa chong trung la SDT, xu ly o tang ung dung.
model Guest {
  id             String    @id @default(cuid())
  soThuTu        Int       @unique // 4 chu so theo dai cua venue
  maBiMat        String    @unique // 8 ky tu bi mat, nam trong QR
  hoTen          String
  sdt            String? // so dien thoai; co thi dung lam khoa chong trung, khong co thi dung ten + ma CORP
  danhXung       String? // Ong, Ba...
  chucVu         String?
  congTy         String? // Company Name
  maCorp         String? // Ma CORP Netsuite
  nhomKhachMoi   String? // Khach Corporate, Doi tac Capella, Taskforce tiep khach...
  donViKinhDoanh String? // Thuoc don vi kinh doanh
  nhomKhach      String? // Agency/bao chi/truyen thong, Khach end-user...
  linhVuc        String?
  nguonKhach     String? // Phan loai khach: Netsuite, Contact moi
  doanhThuDuKien String?
  phongBan       String? // phong ban cua nguoi phu trach
  daGuiThiepGiay Boolean   @default(false) // Round 2: thiep giay
  soGhe          String? // so ghe cho khach VIP, vd 10.01
  soNguoiDen     Int? // so nguoi thuc te den khi check in
  venueId        String
  venue          Venue     @relation(fields: [venueId], references: [id])
  soNguoiMoi     Int       @default(1) // so nguoi duoc moi
  soNguoiXacNhan Int? // so nguoi xac nhan tham du
  trangThai      String    @default("NHAP")
  isVip          Boolean   @default(false)
  ban            String? // line ghe khi xep cho, vd LINE 9 & 10
  salesOwner     String // sales phu trach
  ghiChu         String?
  lyDoChoDuyet   String? // ly do vao hang cho duyet: TRUNG_SDT | VIP
  phatHanhLuc    DateTime?
  xacNhanLuc     DateTime?
  xacNhanBoi     String? // nguoi xac nhan tham du thay khach (sales / BTC)
  checkinLuc     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  checkins CheckinLog[]

  @@index([sdt])
  @@index([maCorp])
  @@index([trangThai])
  @@index([venueId])
}

// Nhat ky check in, phuc vu doi soat va chong quet trung
model CheckinLog {
  id       String   @id @default(cuid())
  guestId  String
  guest    Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  lan      String // Lan 1..4, VIP, Quay ho tro
  leTan    String
  cach     String   @default("") // QR (quet / ma) hoac THU_CONG (nhap so, tim ten)
  ketQua   String // THANH_CONG | TRUNG_LAP | KHONG_HOP_LE
  thoiGian DateTime @default(now())

  @@index([guestId])
}

// Tai khoan dang nhap: BTC, le tan, sales
model StaffUser {
  id         String          @id @default(cuid())
  username   String          @unique
  matKhau    String          @default("") // dang "scrypt$salt$hash"; rong = chua dat, khong dang nhap duoc
  hoTen      String
  vaiTro     String // ADMIN | LE_TAN | SALES
  quanTri    Boolean         @default(false) // ADMIN co quyen quan tri: tai khoan, mat khau, tab Du lieu
  ca         String? // ca truc cua le tan
  doiMatKhau Boolean         @default(false) // bat doi mat khau o lan dang nhap ke tiep
  createdAt  DateTime        @default(now())
  phien      PhienDangNhap[]
}

// Phien dang nhap: cookie giu token ngau nhien, CSDL chi luu ban bam
model PhienDangNhap {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  hetHan    DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Cai dat he thong dang khoa / gia tri (ma khoi tao BTC, phien ban du lieu mau...)
model CaiDat {
  khoa   String @id
  giaTri String
}
