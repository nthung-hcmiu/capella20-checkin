# ============================================================
# CHE DO DEMO CUC BO (mac dinh) - SQLite, chay ngay
# ============================================================
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ============================================================
# CHE DO PRODUCTION - Supabase (Postgres)
# Doi 2 buoc:
#   1. prisma/schema.prisma: provider = "postgresql"
#   2. DATABASE_URL tro ve Supabase connection string ben duoi
# Lay o: Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Dung cong 6543 (pooler) cho runtime, 5432 cho migrate
# ============================================================
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# NEXT_PUBLIC_BASE_URL="https://thiep.capella.vn"
